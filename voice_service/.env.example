# Copy this file to .env and set your real API key
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# Optional: voice name to use with ElevenLabs
VOICE_NAME=alloy
# Ollama local server settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gpt-oss:120b
OLLAMA_TIMEOUT_SECONDS=30
# Route recommendation API
ROUTE_API_BASE_URL=http://127.0.0.1:3000
ROUTE_API_TIMEOUT_SECONDS=5
# ElevenLabs speech-to-text
STT_MODEL=scribe_v2
STT_LANGUAGE_CODE=eng
STT_RECORD_SECONDS=7
STT_SAMPLE_RATE=16000
